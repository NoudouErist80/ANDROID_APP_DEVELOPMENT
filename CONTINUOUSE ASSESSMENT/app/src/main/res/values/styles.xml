<resources>

    <!-- ── Base application theme ─────────────────────────────────────── -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Default TextInputLayout style — outlined box across the whole app -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <!-- Rounded buttons globally -->
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
    </style>

    <!-- ── Global button style ───────────────────────────────────────── -->
    <style name="AppButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ── Outlined button variant ──────────────────────────────────── -->
    <style name="AppButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/colorBorder</item>
    </style>

</resources>