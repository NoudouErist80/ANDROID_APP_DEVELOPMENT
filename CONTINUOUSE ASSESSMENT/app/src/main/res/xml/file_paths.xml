<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration.
    'files-path' maps to Context.getFilesDir() — the app's private internal storage.
    This allows FileProvider to share files from filesDir via content:// URIs.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path
        name="internal_files"
        path="."/>
    <external-path
        name="external_downloads"
        path="Download/"/>
</paths>